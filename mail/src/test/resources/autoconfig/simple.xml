<?xml version="1.0" encoding="UTF-8"?>
<clientInfo>
  <emailProvider id="corp.example" domain="corp.example">
    <displayName>Corp Mail</displayName>
    <displayShortName>Corp</displayShortName>
    <incomingServer type="imap">
      <hostname>imap.corp.example</hostname>
      <port>993</port>
      <socketType>SSL</socketType>
      <authentication>login</authentication>
      <username>%EMAILADDRESS%</username>
    </incomingServer>
    <outgoingServer type="smtp">
      <hostname>smtp.corp.example</hostname>
      <port>587</port>
      <socketType>STARTTLS</socketType>
      <authentication>plain</authentication>
      <username>%EMAILLOCALPART%</username>
      <requireTls>true</requireTls>
    </outgoingServer>
  </emailProvider>
</clientInfo>
